{
  "cleanUrls": true,
  "functions": {
    "api/daily.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/daily?cron=1",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}